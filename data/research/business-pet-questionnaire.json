  "population": { "regionCode": "binjiang", "period": "2020-11-01", "unit": "person", "filters": [{ "field": "age", "op": "gte", "value": 18 }, { "field": "petOwner", "op": "eq", "value": true }, { "field": "petPurchaseParticipant", "op": "eq", "value": true }] },
