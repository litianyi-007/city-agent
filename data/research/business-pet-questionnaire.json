    { "id": "past-snack-categories", "type": "multiple", "prompt": "过去30天购买哪些宠物零食？猫条/犬用条按明确适用物种区分；未购买/不知道排他，不含主粮。", "required": true, "minSelections": 1, "maxSelections": 4, "options": [{ "id": "cat-creamy", "label": "猫用猫条" }, { "id": "dog-chew", "label": "犬用磨牙零食" }, { "id": "freeze-dried", "label": "适用物种明确的冻干零食" }, { "id": "training", "label": "适用物种明确的训练奖励" }, { "id": "none", "label": "未购买" }, { "id": "unknown", "label": "不知道" }] },
