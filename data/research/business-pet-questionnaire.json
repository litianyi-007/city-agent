    { "id": "price-per50g", "type": "single", "prompt": "只针对50克零食的考虑价位？区间左闭右开；不含主粮，未给定真实品牌或价格行情。", "required": true, "options": [{ "id": "under10", "label": "大于0且小于10元/50克" }, { "id": "ten-twenty", "label": "10至小于20元/50克" }, { "id": "twenty-forty", "label": "20至小于40元/50克" }, { "id": "forty-plus", "label": "40元及以上/50克" }, { "id": "none", "label": "不购买" }, { "id": "unknown", "label": "不知道" }] },
    { "id": "planned-channels", "type": "multiple", "prompt": "未来可能通过哪些渠道购买零食？不购买/不知道排他，不代表实际订单。", "required": true, "minSelections": 1, "maxSelections": 3, "options": [{ "id": "online", "label": "线上配送" }, { "id": "pet-shop", "label": "宠物店" }, { "id": "veterinary", "label": "有相关商品的宠物诊疗机构" }, { "id": "community", "label": "社区销售点" }, { "id": "pickup", "label": "线上下单线下自提" }, { "id": "none", "label": "不购买" }, { "id": "unknown", "label": "不知道" }] },
    { "id": "online-handoff", "type": "single", "prompt": "若线上下单，如何接收更适用？本轮不推断履约成本或销量。", "required": true, "options": [{ "id": "pickup", "label": "线下自提" }, { "id": "delivery", "label": "配送" }, { "id": "both", "label": "两者都可" }, { "id": "none", "label": "不购买/不适用" }, { "id": "unknown", "label": "不知道" }] },
    { "id": "travel-minutes", "type": "number", "prompt": "为线下零食网点可接受的单程步行时间？仅配送/不购买/不知道填null。", "required": false, "min": 0, "max": 120, "unit": "分钟/单程步行" },
    { "id": "reachable-streets", "type": "multiple", "prompt": "您个人可到达的街道有哪些？只是粗粒度假设，不是推荐区域/真实订单密度；不知道排他。", "required": true, "minSelections": 1, "maxSelections": 3, "options": [{ "id": "xixing", "label": "西兴" }, { "id": "changhe", "label": "长河" }, { "id": "puyan", "label": "浦沿" }, { "id": "unknown", "label": "不知道" }] },
    { "id": "purchase-barriers", "type": "multiple", "prompt": "购买零食有哪些障碍？没有顾虑/不知道排他。", "required": true, "minSelections": 1, "maxSelections": 4, "options": [{ "id": "suitability", "label": "物种/个体适用性未确认" }, { "id": "ingredients", "label": "成分与安全资料" }, { "id": "freshness", "label": "日期与储存" }, { "id": "price", "label": "价位" }, { "id": "traceability", "label": "来源可追溯性" }, { "id": "none", "label": "没有顾虑" }, { "id": "unknown", "label": "不知道" }] },
    { "id": "price10-intent", "type": "single", "prompt": "仅在适用性和资料均确认的假设下，50克辅助零食10元/包是否考虑？价格为实验设定，不是行情；总体不考虑购买应选不考虑。", "required": true, "options": [{ "id": "yes", "label": "考虑" }, { "id": "maybe", "label": "仍需了解" }, { "id": "no", "label": "不考虑" }, { "id": "unknown", "label": "不知道" }] },
    { "id": "price20-intent", "type": "single", "prompt": "假设与上一题商品和资料相同，仅50克价格改为20元/包是否考虑？同一答卷条件追问，不是随机控价实验；总体不考虑购买应选不考虑。", "required": true, "options": [{ "id": "yes", "label": "考虑" }, { "id": "maybe", "label": "仍需了解" }, { "id": "no", "label": "不考虑" }, { "id": "unknown", "label": "不知道" }] },
    { "id": "traceability-importance", "type": "scale", "prompt": "商品来源资料对这次采购决定的重要性？1不重要，5非常重要；不知道填null。不是宠物健康诊断。", "required": false, "min": 1, "max": 5, "minLabel": "不重要", "maxLabel": "非常重要" },
    { "id": "needed-evidence", "type": "text", "prompt": "决定购买还缺什么证据？可回答无关或不知道，不编造网点、真实订单、品牌功效或市场份额。", "required": false, "maxLength": 500 }
  ] },
