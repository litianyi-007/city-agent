    { "id": "snack-boundary", "type": "single", "prompt": "本问卷只问辅助性奖励零食，明确不含日常主粮。您是否理解这一区别？不了解不能据此推导主粮需求。", "required": true, "options": [{ "id": "understood", "label": "理解，只回答零食" }, { "id": "needs-info", "label": "需要先了解定义" }, { "id": "unknown", "label": "不知道" }] },
