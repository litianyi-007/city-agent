{
  "schemaVersion": "1.0",
  "id": "persona-proof-pet-snack-concept",
  "title": "五层画像与宠物零食网点概念工程自证",
  "objective": "purchase-concerns",
  "decisionContext": {
    "offering": "适用宠物的袋装零食概念。配料、适用性、品牌与试售均待确认；不是猫粮或狗粮等主粮，不支持根据此卷决定主营主粮。价格题以100g袋装零食作假设单位，不是真实成交报价。",
    "buyer": "18岁以上、假设参与猫或狗零食购买的照护购买者。成年、养宠、购买资格均为本次场景假设，目标分母未知。",
    "endUser": "猫或狗，购买者描述采购考虑而不是宠物本人或滨江真实居民意见。",
    "channel": "线上销售配套线下网点的概念比较。具体铺位、客流、订单、租金、履约成本和网点服务能力均未核验。"
  },
  "population": {
    "regionCode": "binjiang",
    "period": "2020-11-01",
    "unit": "person",
    "filters": [
      {
        "field": "age",
        "op": "gte",
        "value": 18
      },
      {
        "field": "petOwner",
        "op": "eq",
        "value": true
      }
    ]
  },
  "questionnaire": {
    "id": "persona-proof-pet-snack-16",
    "version": "1.0",
    "questions": [
      {
        "id": "purchase-qualification",
        "prompt": "仅按本次合成设定，您参与哪类宠物零食的购买？不清楚资格时可回答未知，不能据此更新人口事实。",
