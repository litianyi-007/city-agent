        "required": true,
        "type": "text",
        "maxLength": 600
      },
      {
        "id": "household-context",
        "prompt": "给定当前家庭关系和同住/照护角色中，哪些与本次采购协作有关？未设置请保留未知，不从年龄或性别补编婚育关系。",
        "required": true,
        "type": "text",
        "maxLength": 600
