          },
          {
            "id": "none",
            "label": "不采购零食"
          },
          {
            "id": "unknown",
            "label": "画像信息不足，未知"
          }
        ]
      },
      {
        "id": "value-priority",
        "prompt": "如果考虑一款宠物零食，您首先需要确认哪些信息？最多3项。没有明确偏好时可选择信息不足。",
        "required": true,
