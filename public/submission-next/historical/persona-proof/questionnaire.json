        "required": true,
        "type": "text",
        "maxLength": 600
      },
      {
        "id": "personality-context",
        "prompt": "给定人格倾向中，是否有与收集信息、商量或作决定的方式相关的设定？未设置请写未知。不能由人格分数直接推出品类、价位或购买意愿。",
        "required": true,
        "type": "text",
        "maxLength": 600
      },
