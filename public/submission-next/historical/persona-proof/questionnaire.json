        "type": "single",
        "options": [
          {
            "id": "cat",
            "label": "猫"
          },
          {
            "id": "dog",
            "label": "狗"
          },
          {
            "id": "both",
            "label": "猫和狗"
          },
          {
            "id": "none",
            "label": "不参与购买"
          },
          {
            "id": "unknown",
            "label": "资格未知或不适用"
          }
        ]
      },
      {
        "id": "purchase-role",
        "prompt": "本次设定中，您在采购决策里是什么角色？",
