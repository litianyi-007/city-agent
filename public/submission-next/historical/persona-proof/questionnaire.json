        "type": "single",
        "options": [
          {
            "id": "decider",
            "label": "通常自己决定"
          },
          {
            "id": "shared",
            "label": "与他人商量决定"
          },
          {
            "id": "helper",
            "label": "只协助或收集信息"
          },
          {
            "id": "none",
            "label": "不负责采购"
          },
          {
            "id": "unknown",
            "label": "未知或不适用"
          }
        ]
      },
      {
